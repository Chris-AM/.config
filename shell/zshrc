# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(git zsh-syntax-highlighting zsh-autosuggestions docker kubectl web-search)

source $ZSH/oh-my-zsh.sh

# p10k
[[ ! -f ~/.config/shell/p10k.zsh ]] || source ~/.config/shell/p10k.zsh

# NVM
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# jenv
eval "$(jenv init -)"

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"

# libpq
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"

# zsh-autosuggestions: aceptar palabra a palabra con Option+→
bindkey '^[[1;3C' forward-word

export PATH="$HOME/fvm/default/bin:$PATH"

# gotoh
export PATH="$HOME/.config/gotoh/bin:$PATH"

# secrets (fuera de git — nunca trackear)
[[ -f ~/.gotoh/secrets ]] && source ~/.gotoh/secrets
